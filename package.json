{
  "name": "pathflow-acquisitions-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "worker:login": "wrangler login",
    "worker:whoami": "wrangler whoami",
    "worker:dev": "wrangler dev --config workers/contact/wrangler.toml",
    "worker:deploy": "wrangler deploy --config workers/contact/wrangler.toml",
    "worker:secret:turnstile": "wrangler secret put TURNSTILE_SECRET_KEY --config workers/contact/wrangler.toml",
    "worker:tail": "wrangler tail --config workers/contact/wrangler.toml",
    "worker:typecheck": "tsc -p workers/contact/tsconfig.json",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.2.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.138.0"
  }
}
